  <PropertyGroup Label="UserMacros">
    <SolidWorksInstallDir>C:\Program Files\Dassault Systemes\SOLIDWORKS Apps 2025\SOLIDWORKS</SolidWorksInstallDir>
  </PropertyGroup>
  <!--
    Where pch.h #imports sldworks.tlb, swpublished.tlb and swconst.tlb from.
    Copy those three files from the OLDEST SOLIDWORKS release the add-in should
    support (2025 for now) into ..\typelibs\ and they are used instead of the
    installed release's, so the build fails on any API newer than that
    release. The SOLIDWORKS API is backward compatible, so the same DLL then
    loads in that release and every newer one. *.tlb is gitignored: the files
    are Dassault's. Override with msbuild -p:SwTypeLibDir=...
  -->
  <PropertyGroup Label="UserMacros">
    <SwTypeLibDir Condition="'$(SwTypeLibDir)'=='' and Exists('$(MSBuildProjectDirectory)\..\typelibs\sldworks.tlb')">$(MSBuildProjectDirectory)\..\typelibs</SwTypeLibDir>
    <SwTypeLibDir Condition="'$(SwTypeLibDir)'==''">$(SolidWorksInstallDir)</SwTypeLibDir>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <!--
      Don't run vcpkg's post-build "applocal" step. It copies dependency DLLs
      next to the output, but the static-md triplet links grpc statically so
      there are none, and the step needs pwsh.exe (PowerShell 7).
    -->
    <VcpkgApplocalDeps>false</VcpkgApplocalDeps>
    <!--
      Build vcpkg ports outside the repo. By default vcpkg builds under
      vcpkg_installed\<triplet>\vcpkg\blds, which pushes some of grpc's
      generated sources past Windows' 260-character MAX_PATH limit (cl.exe then
      fails with C1083 "Cannot open include file"). Only the build scratch moves;
      the installed headers and libs stay in vcpkg_installed.
    -->
    <VcpkgAdditionalInstallOptions>&quot;--x-buildtrees-root=$(LOCALAPPDATA)\vcpkg\bt&quot; &quot;--x-packages-root=$(LOCALAPPDATA)\vcpkg\pk&quot;</VcpkgAdditionalInstallOptions>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg" Condition="'$(Platform)'=='x64'">
    <VcpkgTriplet>x64-windows-static-md</VcpkgTriplet>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg" Condition="'$(Platform)'=='Win32'">
    <VcpkgTriplet>x86-windows-static-md</VcpkgTriplet>
  </PropertyGroup>
