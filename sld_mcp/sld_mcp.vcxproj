  <!--
    Generates sld_mcp.pb.{h,cc} and sld_mcp.grpc.pb.{h,cc} from ..\proto\sld_mcp.proto
    into $(SldMcpProtoOutDir), using the protoc and grpc_cpp_plugin that vcpkg
    installed alongside grpc (so the generated code always matches the
    protobuf runtime it links against). Runs after vcpkg's manifest install
    and before anything compiles.
  -->
  <Target Name="SldMcpGenerateProto"
          AfterTargets="VcpkgInstallManifestDependencies"
          BeforeTargets="ClCompile"
          Inputs="$(SldMcpProtoDir)\sld_mcp.proto"
          Outputs="$(SldMcpProtoOutDir)\sld_mcp.pb.cc;$(SldMcpProtoOutDir)\sld_mcp.pb.h;$(SldMcpProtoOutDir)\sld_mcp.grpc.pb.cc;$(SldMcpProtoOutDir)\sld_mcp.grpc.pb.h">
    <PropertyGroup>
      <!-- grpc pulls its code generators in as host dependencies, so they land in the host triplet's tree. -->
      <_SldMcpHostTriplet>$(VcpkgHostTriplet)</_SldMcpHostTriplet>
      <_SldMcpHostTriplet Condition="'$(_SldMcpHostTriplet)' == ''">x64-windows</_SldMcpHostTriplet>
      <_SldMcpProtoc>$(_ZVcpkgInstalledDir)$(_SldMcpHostTriplet)\tools\protobuf\protoc.exe</_SldMcpProtoc>
      <_SldMcpProtoc Condition="!Exists('$(_SldMcpProtoc)')">$(_ZVcpkgCurrentInstalledDir)tools\protobuf\protoc.exe</_SldMcpProtoc>
      <_SldMcpGrpcPlugin>$(_ZVcpkgInstalledDir)$(_SldMcpHostTriplet)\tools\grpc\grpc_cpp_plugin.exe</_SldMcpGrpcPlugin>
      <_SldMcpGrpcPlugin Condition="!Exists('$(_SldMcpGrpcPlugin)')">$(_ZVcpkgCurrentInstalledDir)tools\grpc\grpc_cpp_plugin.exe</_SldMcpGrpcPlugin>
    </PropertyGroup>
    <Error Condition="!Exists('$(_SldMcpProtoc)')" Text="protoc.exe not found under $(_ZVcpkgInstalledDir). Is vcpkg integration enabled (vcpkg integrate install) so vcpkg.json gets installed?" />
    <Error Condition="!Exists('$(_SldMcpGrpcPlugin)')" Text="grpc_cpp_plugin.exe not found under $(_ZVcpkgInstalledDir). Is vcpkg integration enabled (vcpkg integrate install) so vcpkg.json gets installed?" />
    <MakeDir Directories="$(SldMcpProtoOutDir)" />
    <Exec Command="&quot;$(_SldMcpProtoc)&quot; --proto_path=&quot;$(SldMcpProtoDir)&quot; --cpp_out=&quot;$(SldMcpProtoOutDir)&quot; --grpc_out=&quot;$(SldMcpProtoOutDir)&quot; --plugin=protoc-gen-grpc=&quot;$(_SldMcpGrpcPlugin)&quot; &quot;$(SldMcpProtoDir)\sld_mcp.proto&quot;" />
  </Target>
